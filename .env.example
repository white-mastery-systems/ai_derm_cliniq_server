# ============================================================
# AiDerm Cliniq — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# App
APP_ENV=development
APP_NAME="AiDerm Cliniq API"
APP_VERSION=1.0.0
DEBUG=true

# Security — CHANGE THIS in production!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiderm_cliniq

# Redis (Celery broker + rate limiter)
# Required — no default. Use redis://localhost:6379/0 for local dev.
REDIS_URL=redis://localhost:6379/0

# Google Cloud Storage
# Use a relative path from the project root (works in Docker and local dev)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GCS_BUCKET_NAME=aiderm-cliniq-storage

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Providers
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...
DEEPSEEK_API_KEY=sk-...
DEFAULT_LLM_PROVIDER=gemini

# AI Model Names (can be overridden at runtime via admin panel)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o
DEEPSEEK_MODEL=deepseek-chat

# Email (Gmail SMTP)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
FRONTEND_URL=https://your-app-domain.com

# CORS (use ["*"] for development, restrict in production)
CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_CASE=10

# QR Token Expiry
QR_TOKEN_EXPIRE_HOURS=24

# Firebase / Push Notifications
# Use a relative path from the project root
FIREBASE_CREDENTIALS_PATH=credentials/firebase_service_account.json

# Admin Bootstrap — auto-creates the first admin account on startup
# Leave blank to disable. If ADMIN_EMAIL already exists in DB, bootstrap is skipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
